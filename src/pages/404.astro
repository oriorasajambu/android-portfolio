---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';

const studies = (await getCollection('studies')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Page not found — Rio Wirawan" description="This page does not exist." noindex>
  <section class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>This page isn't here.</h1>
    <p class="lead">The link may be out of date. These pages are:</p>
    <ul>
      <li><a href={withBase()}>Home</a></li>
      {studies.map((s) => <li><a href={withBase(`work/${s.id}/`)}>{s.data.title}</a></li>)}
      <li><a href={withBase('#contact')}>Contact</a></li>
    </ul>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(64px, 12vw, 160px);
  }
  ul {
    padding-left: 1.2rem;
    font-size: 1.1rem;
  }
  li {
    padding: 0.35rem 0;
  }
</style>
