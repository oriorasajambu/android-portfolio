---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';

const studyOrder = new Map((await getCollection('studies')).map((s) => [s.id, s.data.order]));
const features = (await getCollection('walkthrough', (w) => w.data.showcase)).sort(
  (a, b) => (studyOrder.get(a.data.study) ?? 99) - (studyOrder.get(b.data.study) ?? 99),
);
const config = features.map((f) => ({
  id: f.id,
  label: f.data.label,
  study: withBase(`work/${f.data.study}/`),
  steps: f.data.steps.map((s) => ({ id: s.id, title: s.title, caption: s.caption, image: withBase(s.image), pins: s.pins })),
}));
const first = features[0]!;
const firstStep = first.data.steps[0]!;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="showcase" data-showcase data-mode="2d">
  <div class="stage-top" data-js-only>
    <div class="feature-picker" role="group" aria-label="Feature">
      {
        features.map((f, i) => (
          <button type="button" class="pick" data-pick={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.data.label}
          </button>
        ))
      }
    </div>
    <div class="view-toggle" role="group" aria-label="View" data-view-toggle hidden>
      <button type="button" data-view="3d" aria-pressed="false">3D</button>
      <button type="button" data-view="2d" aria-pressed="true">2D</button>
    </div>
  </div>

  <div class="stage-body">
    <div class="stage" data-stage>
      <div class="floor" aria-hidden="true"></div>
      <ol class="screens" aria-label="Illustrated screens">
        {
          features.map((f, fi) =>
            f.data.steps.map((s, si) => (
              <li class="screen" data-feature={f.id} data-step={si} data-active={fi === 0 && si === 0 ? '' : undefined}>
                <figure>
                  <div class="phone">
                    <div class="screen-wrap">
                      <img
                        src={withBase(s.image)}
                        alt={s.alt}
                        width="360"
                        height="760"
                        loading={fi === 0 && si === 0 ? 'eager' : 'lazy'}
                        fetchpriority={fi === 0 && si === 0 ? 'high' : undefined}
                        decoding="async"
                      />
                      {s.pins.map((p, pi) => (
                        <span class="pin" aria-hidden="true" style={`left:${p.x}%;top:${p.y}%`}>
                          {pi + 1}
                        </span>
                      ))}
                    </div>
                  </div>
                  <figcaption>
                    <span class="fc-title">
                      {f.data.label} · {si + 1}/3 — {s.title}
                    </span>
                    {s.caption}
                    <ol class="fc-pins">{s.pins.map((p) => <li>{p.text}</li>)}</ol>
                    <span class="label-illustration">{s.kind === 'illustration' ? 'Illustration' : 'Approved image'}</span>
                  </figcaption>
                </figure>
              </li>
            )),
          )
        }
      </ol>
      <div class="canvas-host" data-canvas-host aria-hidden="true"></div>
      <span class="status-chip" data-status-chip hidden></span>
      <span class="label-illustration stage-label" data-js-only>Illustration · synthetic data</span>
      <p class="hint" data-hint data-js-only></p>
      <button type="button" class="reset-view" data-reset-view hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path></svg
        >
        Reset view
      </button>
    </div>

    <div class="caption" data-js-only aria-live="polite" aria-atomic="true">
      <p class="count" data-count>{first.data.label} · 01 / 03</p>
      <h3 data-title>{firstStep.title}</h3>
      <p class="caption-text" data-caption>{firstStep.caption}</p>
      <p class="notice-head" data-notice-head>What to notice</p>
      <ol class="notice-list" data-notice>
        {
          firstStep.pins.map((p, i) => (
            <li>
              <span class="num" aria-hidden="true">
                {i + 1}
              </span>
              <span>{p.text}</span>
            </li>
          ))
        }
      </ol>
      <a class="study-link" data-study-link href={withBase(`work/${first.data.study}/`)}>Read the {first.data.label} study →</a>
    </div>
  </div>

  <div class="fallback" data-fallback role="status" hidden>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
      ><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16.5v.5"></path></svg
    >
    <span data-status-msg></span>
    <button type="button" class="retry" data-retry hidden>Retry</button>
  </div>

  <div class="rail" data-js-only>
    <button type="button" class="arrow" data-prev aria-label="Previous screen" disabled>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path d="M15 6l-6 6 6 6"></path></svg
      >
    </button>
    <ol class="steps" aria-label="Steps">
      {
        first.data.steps.map((s, i) => (
          <li>
            <button type="button" class="step" data-step-btn={i} aria-current={i === 0 ? 'step' : 'false'}>
              <span class="bar" aria-hidden="true" />
              <span class="step-label">
                {pad(i + 1)} · <span data-step-title>{s.title}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ol>
    <button type="button" class="arrow primary" data-next aria-label="Next screen">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path d="M9 6l6 6-6 6"></path></svg
      >
    </button>
  </div>

  <script type="application/json" data-showcase-config set:html={JSON.stringify(config)} />
</div>

<script>
  import { initShowcase } from '../scripts/showcase';
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((el) => initShowcase(el));
</script>

<style>
  .showcase {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(16px, 2.2vw, 28px);
    border-radius: 32px;
    background: var(--surface-2);
    border: 1px solid var(--line);
  }

  /* ---------- top row ---------- */
  .stage-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
  }
  .feature-picker {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--surface-3);
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 4px;
    mask-image: linear-gradient(to right, transparent, #000 14px, #000 calc(100% - 14px), transparent);
  }
  .feature-picker::-webkit-scrollbar {
    display: none;
  }
  .pick {
    flex: none;
    scroll-snap-align: start;
    white-space: nowrap;
    min-height: 44px;
    padding: 0.35rem 0.95rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    font-size: 0.94rem;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
  }
  .pick[aria-pressed='true'] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  .view-toggle {
    margin-left: auto;
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .view-toggle button {
    min-width: 48px;
    min-height: 38px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 800;
    cursor: pointer;
  }
  .view-toggle button[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .view-toggle button:disabled {
    cursor: progress;
  }

  /* ---------- stage ---------- */
  .stage-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    gap: clamp(20px, 3vw, 32px);
    align-items: center;
  }
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 470px;
    overflow-x: clip;
    overflow-clip-margin: 0;
  }
  .floor {
    position: absolute;
    left: 50%;
    bottom: 12px;
    width: 230px;
    height: 26px;
    margin-left: -115px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(16 23 19 / 0.26), rgb(16 23 19 / 0));
  }
  :global([data-theme='dark']) .floor {
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0));
  }
  .screens {
    list-style: none;
    margin: 0;
    padding: 0;
    width: min(100%, 212px);
  }
  .phone {
    padding: 9px;
    border-radius: 40px;
    background: #1b231e;
    box-shadow:
      0 0 0 1px #2d3a32,
      0 30px 60px -24px rgb(16 23 19 / 0.45);
  }
  .screen-wrap {
    position: relative;
    border-radius: 32px;
    overflow: hidden;
  }
  .screen-wrap img {
    display: block;
    width: 100%;
    height: auto;
  }
  .pin {
    position: absolute;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    border-radius: 50%;
    background: #166534;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    display: grid;
    place-items: center;
    box-shadow:
      0 0 0 2px #fff,
      0 0 0 5px rgb(22 101 52 / 0.25);
  }
  figure {
    margin: 0;
  }
  figcaption {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .fc-title {
    display: block;
    font-weight: 700;
    color: var(--ink);
  }
  .fc-pins {
    margin: 0.5rem 0;
    padding-left: 1.2rem;
  }

  /* With JavaScript: one screen at a time; the caption column carries the text. */
  :global(.js) .screen:not([data-active]) {
    display: none;
  }
  :global(.js) .screen figcaption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  /* In 3D the canvas paints the phone; the image stays for assistive tech. */
  .showcase[data-mode='3d'] .phone {
    opacity: 0;
  }
  .canvas-host {
    position: absolute;
    inset: 0 -12%;
    pointer-events: none;
  }
  .showcase[data-mode='3d'] .canvas-host {
    pointer-events: auto;
  }
  .canvas-host :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }
  .status-chip {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-2);
  }
  .status-chip::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2.5px solid var(--line);
    border-top-color: var(--accent);
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-chip::before {
      animation: none;
    }
  }
  .stage-label {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    background: var(--surface-2);
  }
  .reset-view {
    position: absolute;
    right: 0;
    top: 0;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--accent);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: var(--shadow);
  }
  .hint {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* ---------- caption column ---------- */
  .caption {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .count {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .caption h3 {
    margin: 0;
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    font-weight: 800;
  }
  .caption-text {
    margin: 0;
    color: var(--ink-2);
  }
  .notice-head {
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .notice-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .notice-list :global(li) {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .notice-list :global(.num) {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 800;
    display: grid;
    place-items: center;
  }
  .study-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    text-decoration: none;
  }

  /* ---------- fallback notice ---------- */
  .fallback {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px 10px 14px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .fallback svg {
    flex: none;
    color: var(--warn);
  }
  .fallback span {
    flex-grow: 1;
  }
  .retry {
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1.5px solid var(--accent);
    background: var(--surface);
    color: var(--accent);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 800;
    cursor: pointer;
  }

  /* ---------- step rail ---------- */
  .rail {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .arrow {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    background: var(--surface);
    color: var(--accent);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .arrow.primary {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .steps {
    flex-grow: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .step {
    width: 100%;
    min-height: 54px;
    padding: 8px 12px;
    border: 0;
    border-radius: 14px;
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
    display: grid;
    gap: 7px;
    align-content: center;
  }
  .step .bar {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: var(--line);
  }
  .step-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--muted);
    line-height: 1.25;
  }
  .step[aria-current='step'] {
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .step[aria-current='step'] .step-label {
    color: var(--ink);
  }
  .step[aria-current='step'] .bar,
  .step[data-done] .bar {
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .step .bar {
      transition: background-color 0.2s ease;
    }
  }

  /* ---------- without JavaScript: the whole ordered sequence ---------- */
  :global(html:not(.js)) .stage-body {
    grid-template-columns: minmax(0, 1fr);
  }
  :global(html:not(.js)) .stage {
    min-height: 0;
  }
  :global(html:not(.js)) .floor {
    display: none;
  }
  :global(html:not(.js)) .screens {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 2rem;
  }
  :global(html:not(.js)) .pin {
    display: none;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 760px) {
    .stage-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .stage {
      min-height: 460px;
      padding-block: 30px 28px;
    }
    .screens {
      width: min(100%, 196px);
    }
    .view-toggle {
      margin-left: auto;
    }
    .step-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .step {
      min-height: 44px;
      padding: 0 10px;
    }
  }
</style>
