---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';

const features = (await getCollection('walkthrough')).sort((a, b) => (a.id === 'qr' ? -1 : b.id === 'qr' ? 1 : 0));
const config = features.map((f) => ({
  id: f.id,
  label: f.data.label,
  steps: f.data.steps.map((s) => ({ id: s.id, title: s.title, caption: s.caption, image: withBase(s.image) })),
}));
const first = features[0]!;
---

<div class="showcase" data-showcase>
  <div class="stage-col">
    <div class="stage" data-stage>
      <ol class="screens" aria-label="Illustrated screens">
        {
          features.map((f, fi) =>
            f.data.steps.map((s, si) => (
              <li class="screen" data-feature={f.id} data-step={si} data-active={fi === 0 && si === 0 ? '' : undefined}>
                <figure>
                  <div class="phone">
                    <img
                      src={withBase(s.image)}
                      alt={s.alt}
                      width="360"
                      height="760"
                      loading={fi === 0 && si === 0 ? 'eager' : 'lazy'}
                      fetchpriority={fi === 0 && si === 0 ? 'high' : undefined}
                      decoding="async"
                    />
                  </div>
                  <figcaption>
                    <span class="fc-title">
                      {f.data.label} · {si + 1}/3 — {s.title}
                    </span>
                    {s.caption}
                    <span class="label-illustration">{s.kind === 'illustration' ? 'Illustration' : 'Approved image'}</span>
                  </figcaption>
                </figure>
              </li>
            )),
          )
        }
      </ol>
      <div class="canvas-host" data-canvas-host aria-hidden="true"></div>
    </div>
    <p class="label-row">
      <span class="label-illustration">Illustration · synthetic data</span>
      <span class="mode-note" data-mode-note data-js-only></span>
    </p>
  </div>

  <div class="panel" data-js-only>
    <div class="feature-picker" role="group" aria-label="Feature">
      {
        features.map((f, i) => (
          <button type="button" class="pick" data-pick={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.data.label}
          </button>
        ))
      }
    </div>

    <div class="caption" aria-live="polite" aria-atomic="true">
      <p class="count" data-count>Step 1 of 3</p>
      <h3 data-title>{first.data.steps[0]!.title}</h3>
      <p data-caption>{first.data.steps[0]!.caption}</p>
    </div>

    <div class="stepper">
      <button type="button" class="btn ghost" data-prev aria-label="Previous screen" disabled>← Previous</button>
      <button type="button" class="btn ghost" data-next aria-label="Next screen">Next →</button>
    </div>

    <div class="mode">
      <button type="button" class="btn ghost small" data-mode-toggle hidden>Enable 3D</button>
      <p class="status" data-status-msg role="status"></p>
    </div>
  </div>

  <script type="application/json" data-showcase-config set:html={JSON.stringify(config)} />
</div>

<script>
  import { initShowcase } from '../scripts/showcase';
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((el) => initShowcase(el));
</script>

<style>
  .showcase {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }
  .stage-col {
    display: grid;
    overflow-x: clip;
    overflow-clip-margin: 0;
    justify-items: center;
    gap: 0.75rem;
  }
  .stage {
    position: relative;
    width: min(100%, 340px);
    aspect-ratio: 360 / 760;
  }
  .screens {
    list-style: none;
    margin: 0;
    padding: 0;
    height: 100%;
  }
  .phone {
    padding: 10px;
    border-radius: 44px;
    background: #1b231e;
    box-shadow:
      0 0 0 1px #2d3a32,
      0 30px 60px -20px rgb(16 23 19 / 0.45);
  }
  .phone img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 34px;
  }
  figure {
    margin: 0;
  }
  figcaption {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .fc-title {
    display: block;
    font-weight: 700;
    color: var(--ink);
  }
  figcaption .label-illustration {
    margin-top: 0.5rem;
  }

  /* With JavaScript: one screen at a time, caption lives in the panel. */
  :global(.js) .screen:not([data-active]) {
    display: none;
  }
  :global(.js) .screen figcaption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  /* In 3D mode keep the active image for assistive tech but show the canvas. */
  .showcase[data-mode='3d'] .phone {
    opacity: 0;
  }
  .canvas-host {
    position: absolute;
    inset: -10% -30% -1%;
    pointer-events: none;
  }
  .showcase[data-mode='3d'] .canvas-host {
    pointer-events: auto;
  }
  .canvas-host :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  /* Without JavaScript: the full ordered sequence. */
  :global(html:not(.js)) .stage {
    aspect-ratio: auto;
    width: 100%;
  }
  :global(html:not(.js)) .screens {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 2rem;
  }
  :global(html:not(.js)) .showcase {
    grid-template-columns: 1fr;
  }

  .label-row {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .panel {
    display: grid;
    gap: 1.5rem;
    align-content: center;
  }
  .feature-picker {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: var(--surface-2);
    justify-self: start;
  }
  .pick {
    min-height: 44px;
    padding: 0 1rem;
    white-space: nowrap;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .pick[aria-pressed='true'] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  .caption {
    min-height: 11rem;
  }
  .count {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .caption h3 {
    font-size: 1.5rem;
  }
  .caption p:last-child {
    color: var(--ink-2);
    max-width: 48ch;
  }
  .stepper {
    display: flex;
    gap: 0.75rem;
  }
  .mode {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
  }
  .small {
    min-height: 44px;
    font-size: 0.92rem;
    padding: 0.5rem 1rem;
  }
  .status {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .showcase {
      grid-template-columns: 1fr;
    }
    .stage {
      width: min(100%, 280px);
    }
    .caption {
      min-height: 0;
    }
  }
</style>
